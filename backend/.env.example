# ---- Server ----
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
MAX_UPLOAD_MB=20

# ---- Embeddings ----
# sentence-transformers (recommended, downloads ~90 MB model on first run) or hash (tiny, no download, lower quality; used by tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Answer generation ----
# none = local extractive mode only | gemini | openai_compatible (Groq, OpenRouter, etc.)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Only for openai_compatible, e.g. https://api.groq.com/openai/v1
LLM_BASE_URL=

# ---- Retrieval tuning (optional) ----
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
# Leave empty to use sensible default per embedding backend
MIN_RELEVANCE=
